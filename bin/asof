#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/lightyear"

cmd = ARGV.shift
case cmd
when "ingest-fixture"
  kind, path = ARGV[0], ARGV[1]
  abort "usage: bin/asof ingest-fixture edgar|fred PATH [--name SERIES]" unless kind && path
  name = ARGV.include?("--name") ? ARGV[ARGV.index("--name") + 1] : "fred.unrate"
  case kind
  when "edgar" then IngestEdgarJob.perform_now(path: path)
  when "fred" then IngestFredJob.perform_now(path: path, name: name)
  else abort "unknown kind #{kind}"
  end
  puts "ok"
when "snapshot"
  require "as_of/state"
  require "as_of/markdown"
  payload = AsOf::State.snapshot
  puts AsOf::Markdown.state(payload)
when "ingest-live"
  abort "refusing: set INGEST_LIVE=1" unless ENV["INGEST_LIVE"] == "1"
  AsOf.sec_user_agent
  abort "FRED_API_KEY required" if ENV["FRED_API_KEY"].to_s.empty?
  abort "ingest-live HTTP fetch not wired; jobs should use Connections + whitelist"
when "verify"
  exec RbConfig.ruby, File.expand_path("lightyear", __dir__), "ledger", "verify", "--json", *ARGV
when "-h", "--help", nil
  puts <<~USAGE
    bin/asof ingest-fixture edgar|fred PATH [--name SERIES]
    bin/asof snapshot
    bin/asof ingest-live   # requires INGEST_LIVE=1, CONTACT_EMAIL, FRED_API_KEY
    bin/asof verify        # lightyear ledger verify --json
  USAGE
else
  abort "unknown command #{cmd}"
end
