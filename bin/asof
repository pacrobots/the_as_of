#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/lightyear"
require "yaml"

cmd = ARGV.shift
case cmd
when "ingest-fixture"
  kind, path = ARGV[0], ARGV[1]
  abort "usage: bin/asof ingest-fixture edgar|fred PATH [--name SERIES]" unless kind && path
  name = ARGV.include?("--name") ? ARGV[ARGV.index("--name") + 1] : "fred.unrate"
  case kind
  when "edgar" then IngestEdgarJob.perform_now(path: path)
  when "fred" then IngestFredJob.perform_now(path: path, name: name)
  else abort "unknown kind #{kind}"
  end
  puts "ok"
when "snapshot"
  require "as_of/state"
  require "as_of/markdown"
  payload = AsOf::State.snapshot
  puts AsOf::Markdown.state(payload)
when "ingest-live"
  abort "refusing: set INGEST_LIVE=1" unless ENV["INGEST_LIVE"] == "1"
  AsOf.sec_user_agent
  require "as_of/secrets"
  abort "FRED API key missing" unless AsOf::Secrets.fred_api_key?
  YAML.safe_load_file(File.expand_path("../config/state_series.yaml", __dir__)).fetch("series").each do |row|
    next unless row["source"] == "fred"
    IngestFredJob.perform_now(name: row["name"])
    puts "fred #{row['name']} ok"
  end
when "fetches"
  n = (ARGV[0] || 20).to_i
  FetchLog.order(id: :desc).limit(n).each do |row|
    puts [row.created_at.utc.iso8601, row.source_kind, row.native_id, row.http_status,
          row.outcome, row.content_hash, row.error_message].compact.join(" ")
  end
when "ingest-status"
  %w[edgar fred].each do |kind|
    row = FetchLog.last_ok(kind)
    if row
      puts "#{kind} last=#{row.created_at.utc.iso8601} outcome=#{row.outcome} hash=#{row.content_hash}"
    else
      puts "#{kind} last=never"
    end
  end
when "secrets-import"
  path = ARGV[0] or abort "usage: bin/asof secrets-import PATH"
  exec RbConfig.ruby, File.expand_path("import-fred-key", __dir__), path
when "verify"
  exec RbConfig.ruby, File.expand_path("lightyear", __dir__), "ledger", "verify", "--json", *ARGV
when "-h", "--help", nil
  puts <<~USAGE
    bin/asof ingest-fixture edgar|fred PATH [--name SERIES]
    bin/asof snapshot
    bin/asof ingest-live     # INGEST_LIVE=1 + FRED key in credentials store
    bin/asof fetches [N]
    bin/asof ingest-status
    bin/asof verify          # lightyear ledger verify --json
  USAGE
else
  abort "unknown command #{cmd}"
end
