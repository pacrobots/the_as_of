/.bundle

# Local Lightyear checkout (not part of this product). Used for #55
# and as a source overlay: `bundle config local.lightyear vendor/lightyear`
/vendor/lightyear/

/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

/storage/*
!/storage/.keep

/config/master.key
*.sqlite3
*.sqlite3-journal

# `lightyear blueprint reflect` writes this as an instant, git-independent undo of the last reflect.
/blueprint.yml.bak
